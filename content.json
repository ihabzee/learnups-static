  "features": {
    "tag": "Why LearnUps",
    "title": "Everything you need.<br>Nothing you don't.",
    "subtitle": "Purpose-built for instructors who want a powerful, flexible, and affordable assessment tool — not a bloated enterprise suite.",
    "cards": [
      {
        "icon": "📋",
        "title": "Diverse Question Types",
        "desc": "Multiple choice, short answer, fill-in-the-blank, matching, ordering, and more — all serving different learning outcomes to meet pedagogical goals."
      },
      {
        "icon": "⚡",
        "title": "Instant Auto-Grading",
        "desc": "Save hours every week. LearnUps automatically grades submissions and syncs scores back to your LMS grade book in real time."
      },
      {
        "icon": "📊",
        "title": "Deep Analytics",
        "desc": "See which questions students struggle with most. Track performance trends, identify learning gaps, and iterate on your content."
      },
      {
        "icon": "🔗",
        "title": "LTI Integration",
        "desc": "Connect LearnUps to Canvas, Moodle, or any LTI-compatible LMS with a few clicks. Grades sync automatically — no manual exports."
      },
      {
        "icon": "📚",
        "title": "Open Education Resources",
        "desc": "Adopt OER content and we'll help you build assessments around it — saving you weeks of question-writing time."
      },
      {
        "icon": "🛡️",
        "title": "Academic Integrity",
        "desc": "Randomized question pools, time limits, and per-student question shuffling make every attempt unique and harder to share answers."
      }
    ]
  },
